# ============================================
# BAJE AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in values
# NEVER commit .env to GitHub!

# Server
PORT=3000
NODE_ENV=development

# ============================================
# Optional AI Provider (for smart fallback)
# ============================================
# Uncomment ONE provider below:

# --- OpenAI ---
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-openai-key-here
# AI_MODEL=gpt-3.5-turbo

# --- Google Gemini ---
# AI_PROVIDER=gemini
# AI_API_KEY=your-gemini-api-key-here
# AI_MODEL=gemini-1.5-flash

# If no AI provider is configured, Baje works using the built-in local engine.
